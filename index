<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The Monk’s Path</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:wght@500;700&family=Nunito+Sans:wght@400;600;700&display=swap">
<style>
:root{--bg:#e8ede7;--card:#f6f8f4;--ink:#1d2b26;--mute:#56655e;--acc:#9a5f10;--on:#fff;--g:#2f5d50;--line:#c9d3c8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121c18;--card:#1b2823;--ink:#e3ebe4;--mute:#9db0a6;--acc:#e3a94a;--on:#1b1408;--g:#7fb5a2;--line:#2c3c35;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#121c18;--card:#1b2823;--ink:#e3ebe4;--mute:#9db0a6;--acc:#e3a94a;--on:#1b1408;--g:#7fb5a2;--line:#2c3c35;color-scheme:dark}
html,body{height:auto;margin:0}body{background:var(--bg);color:var(--ink);font:16px/1.5 "Nunito Sans",system-ui,sans-serif;max-width:560px;margin:0 auto;padding:16px 16px 40px}
h1,h2,h3{font-family:Spectral,Georgia,serif;margin:0}h2{font-size:1.25rem;margin:20px 0 8px}h3{font-size:1.05rem}
.hero{display:flex;align-items:center;gap:16px;padding:8px 0}.ring{position:relative;width:120px;height:120px;flex:none}
.ring svg{transform:rotate(-90deg)}.ring b{position:absolute;inset:0;display:grid;place-items:center;font:700 2rem Spectral,serif}
.ring small{position:absolute;left:0;right:0;bottom:22px;text-align:center;color:var(--mute);font-size:.7rem}
.sub{color:var(--mute);margin:2px 0}.flames{font-size:1.4rem;letter-spacing:4px}
nav{display:flex;gap:6px;margin:12px 0;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);padding:6px 0;z-index:2}
button{font:inherit;min-height:44px;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);padding:6px 12px;cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
nav button{flex:1;padding:6px 4px}nav .on,.chip.on{background:var(--g);color:var(--bg);border-color:var(--g);font-weight:700}
.pri{background:var(--acc);color:var(--on);border-color:var(--acc);font-weight:700;width:100%;margin-top:12px}
.row{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}.chip{flex:1;min-width:90px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin:10px 0}
label.ck{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--line)}label.ck:last-child{border:0}
input[type=checkbox]{width:22px;height:22px;accent-color:var(--g);flex:none;margin-top:2px}
.bar{height:8px;background:var(--line);border-radius:6px;overflow:hidden}.bar i{display:block;height:100%;background:var(--g)}
.tok{color:var(--acc);font-weight:700}summary{cursor:pointer;min-height:32px;padding:4px 0}details>p{margin:2px 0 8px}textarea{width:100%;box-sizing:border-box;font:inherit;background:var(--bg);color:var(--ink);border:1.5px solid var(--line);border-radius:10px;padding:10px;min-height:96px;resize:vertical}.log{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--line);font-size:.92rem}
#toast{position:fixed;left:16px;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));max-width:528px;margin:auto;background:var(--g);color:var(--bg);padding:12px 14px;border-radius:12px;font-weight:600;display:none}
@media (prefers-reduced-motion:no-preference){.bar i{transition:width .5s}circle.p{transition:stroke-dashoffset .6s}}
</style></head><body>
<div class="hero"><div class="ring"><svg width="120" height="120" viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" fill="none" stroke="var(--line)" stroke-width="9"/><circle class="p" id="rp" cx="60" cy="60" r="52" fill="none" stroke="var(--acc)" stroke-width="9" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="326.7"/></svg><b id="lv">1</b><small>level</small></div>
<div><h1 id="rk">Initiate</h1><p class="sub" id="xp"></p><div class="flames" id="fl" aria-label="Sessions this week"></div></div></div>
<nav id="nav"></nav><main id="main"></main><div id="toast" role="status"></div>
<script>
const XPL=350,K="monkspath1";
const T={wind:{n:"Way of the Wind",s:"Legs and conditioning",
g:["Treadmill or bike: 6 rounds of 1 min brisk, 1 min easy","Leg press 3×10","Goblet squat with a dumbbell 3×10","Step-ups 3×8 per leg","Seated leg curl 3×10"],
h:["Shadow rope (no jumping): 6 rounds of 30s on, 60s off","Tempo squats 3×10 (3 seconds down)","Reverse lunges 3×8 per leg","Stair or sturdy-step step-ups 3×8 per leg","Wall sit 3×20s, calf raises 3×15"]},
fist:{n:"Way of the Fist",s:"Upper body and core",
g:["Lat pulldown 3×10","Seated cable row 3×10","Chest press machine 3×10","Dumbbell shoulder press 3×10","Plank 3×30s"],
h:["Push-up variation 3 sets, stop 2 reps short of failure","8 lb bent-over rows 3×12","8 lb overhead press 3×12","Dead bug 3×10","Hollow hold 3×20s"]},
staff:{n:"Way of the Staff",s:"Skill and mobility",
g:["10 min easy incline walk","Single-leg balance 3×30s per side","Cable face pulls 2×15","Hip, hamstring and chest stretches 5 min","Stance holds in the stretching area 3×30s"],
h:["PVC staff flow: figure-eights and overhead sweeps, 3 rounds of 3 min","Horse stance holds 3×30s","Single-leg balance 3×30s per side","Hip and shoulder mobility 5 min","Slow breathing 2 min"]}};
const FL=["March in place 2 min","Squats 2×8 (or chair squats)","Incline push-ups 2×6 against a counter","Staff flow 1 min","Easy stretch 2 min"];
const LAD={push:["Push-ups",["Wall push-up","Counter push-up","Low-incline push-up","Knee push-up","Slow-lowering push-up","Full push-up","Tempo push-up","Archer push-up"]],legs:["Legs",["Chair squat","Bodyweight squat","Split squat","Reverse lunge","Bulgarian split squat","Assisted pistol squat"]],core:["Core",["Dead bug","Plank","Hollow hold","Hollow rock","Tuck L-sit"]],breath:["Breath and stamina",["Brisk-walk intervals","Shadow rope","Jump rope 20s/40s","Jump rope 30s/30s","Jump rope 40s/20s"]],staff:["Staff",["Grip and stance","Slow figure-eights","Overhead sweeps","Blocks and thrusts","Strike combos","Full flow"]]};
const RW={t:["Gaming session (45–60 min)","A show or movie episode","Hobby hour: podcast, Spanish, a walk, playing with the kitties, a research rabbit hole","Creative time: sketch, journal, photos"],
e:["A new walking route","Park or lakefront visit","Botanical garden","Library trip","Free museum day","Free local event"],
r:["Build a new playlist","Refresh your wallpaper","Pick a new character title","Rearrange a corner of your space"]};
const RN=["Initiate","Acolyte","Adept"];
const GL=[["goblet squat","Hold one dumbbell against your chest with both hands. Same squat as the standard one, but the weight in front helps you stay upright and sit deeper."],["tempo squat","Same squat, but lower for a slow count of 3, pause one beat at the bottom, then stand up normally. Same depth, much harder control."],["reverse lunge","From standing, step one foot straight back and lower the back knee toward the floor, then push through the front heel to return. Gentler on the knees than a forward lunge."],["step-up","Put one whole foot on a sturdy step, stand up fully on it, then lower slowly. Push with the top leg, not the foot on the floor."],["shadow rope","Turn imaginary rope handles with your wrists while bouncing softly on the balls of your feet. It gives the same rhythm and heart-rate lift as jump rope without the noise for the neighbors below."],["wall sit","Back flat on a wall, thighs parallel to the floor, knees over ankles. Unlike a squat, you hold still."],["leg press","Seated machine: feet shoulder-width on the plate, lower until knees reach about 90°, push without locking your knees. Like a squat with your back supported."],["leg curl","Seated machine that curls your heels toward you to work the back of your thighs, which squats and lunges train less directly."],["push-up variation","Use your current rung from the Skills tab (wall, counter, knee, or full). Stop 2 reps before you would fail."],["bent-over row","Hinge forward at the hips with a flat back, 8 lb weights hanging, then pull your elbows toward your hip pockets and squeeze your shoulder blades."],["overhead press","Weights at shoulder height, press straight up until your arms are near your ears. Keep ribs down so your lower back does not arch."],["lat pulldown","Seated machine: pull the bar to your upper chest with elbows going down and back. A supported version of a pull-up motion."],["seated cable row","Pull the handle to your belly button with a tall chest. This is horizontal pulling, which balances the vertical pulldown."],["face pull","Cable at face height with a rope: pull toward your forehead with elbows high and wide. Targets the upper back and rear shoulders."],["dead bug","Lie on your back, arms up, knees over hips. Slowly lower the opposite arm and leg while your lower back stays pressed into the floor."],["hollow hold","Lie on your back, press your lower back down, and lift shoulders and legs slightly off the floor. Bend your knees to make it easier."],["plank","Forearms and toes (or knees) on the floor, straight line from head to heel, glutes and abs squeezed. You hold still and brace."],["horse stance","Feet about twice shoulder-width, toes slightly out, sit into a half-squat with a tall chest. A classic martial arts position that builds leg endurance."],["single-leg balance","Stand on one foot with a soft knee and eyes forward. Touch a wall lightly at first. Harder: close your eyes."],["staff flow","Link two or three moves from Staff school into one slow, smooth pattern."]];
const gl=x=>{const m=GL.find(([k])=>x.toLowerCase().includes(k));return m?`<details><summary class="sub">How it differs</summary><p class="sub">${m[1]}</p></details>`:""};
const RD={"Wall push-up":"Hands on a wall at chest height, shoulder-width apart, body in a straight line. Bend your elbows so your chest nears the wall. Target: 3×12.","Counter push-up":"Hands on a kitchen counter or sturdy desk, same straight body. Target: 3×10.","Low-incline push-up":"Hands on a low stair or sturdy couch seat. More of your body weight is on your hands. Target: 3×10.","Knee push-up":"Knees on the floor, straight line from knees to head. Target: 3×10.","Slow-lowering push-up":"Start at the top of a full push-up and lower for 3–5 seconds, then drop to your knees to come back up. Target: 3×5.","Full push-up":"Toes and hands on the floor, body straight, chest to a fist’s height above the floor. Target: 3×8.","Tempo push-up":"A full push-up lowered for 3 seconds, with a 1-second pause at the bottom. Target: 3×6.","Archer push-up":"Wide hands: lower toward one hand while the other arm stays straight, then switch sides. Target: 3×4 per side.","Chair squat":"Sit back to a chair, lightly touch it, and stand. Target: 3×10.","Bodyweight squat":"Feet shoulder-width, sit hips back and down, chest up. Target: 3×12.","Split squat":"Feet staggered in a long stride. Drop the back knee straight down and rise, without stepping. Target: 3×8 per side.","Reverse lunge":"Step back, lower, and push through the front heel to return. Target: 3×8 per side.","Bulgarian split squat":"A split squat with the back foot resting on a couch or bench. Target: 3×6 per side.","Assisted pistol squat":"One-legged squat holding a doorframe for light help. Target: 3×4 per side.","Dead bug":"Opposite arm and leg lower slowly, lower back flat. Target: 3×10.","Plank":"Straight line head to heel. Target: 3×30s.","Hollow hold":"Lower back pressed down, shoulders and legs lifted. Target: 3×20s.","Hollow rock":"From a hollow hold, rock gently like a banana. Target: 3×10.","Tuck L-sit":"Seated, press hands into the floor or chair edges and lift your hips with knees tucked. Target: 3×10s.","Brisk-walk intervals":"1 minute fast, 1 minute easy. Target: 8 rounds.","Shadow rope":"Quiet pretend rope at home. Target: 8 rounds of 30s on, 60s off.","Jump rope 20s/40s":"Real rope, outdoors or at the gym, not on a 2nd-floor floor. Target: 8 rounds.","Jump rope 30s/30s":"Same, with less rest. Target: 8 rounds.","Jump rope 40s/20s":"Hardest rope interval. Target: 6 rounds.","Grip and stance":"Hold the pipe by the middle, hands shoulder-width, palms down, loose grip. Feet shoulder-width, soft knees. This is your home position.","Slow figure-eights":"Trace a sideways 8 in front of you by rolling your wrists. Target: 1 min each direction.","Overhead sweeps":"Raise the pipe overhead, then sweep it in a wide arc down to one side and back up, turning your hips with it. Target: 8 per side.","Blocks and thrusts":"Slow blocks up, down and out to the side, then a forward thrust with a small lunge step. Target: 8 each.","Strike combos":"Link a diagonal swing, a block and a thrust, slowly. Target: 3 clean rounds.","Full flow":"Connect 3 or more moves into a continuous 2-minute pattern with steady breathing."};
const STF=[["Grip and stance","Hold the pipe by the middle, hands shoulder-width apart, palms down, loose grip. Feet shoulder-width, knees soft. Return here between moves."],["Slow figure-eight","Trace a sideways 8 in front of your body by rolling your wrists and letting the pipe’s tip draw big loops. Elbows soft. 1 minute each direction."],["Overhead sweep","Raise the pipe overhead, then sweep it in a wide arc down to one side and back up, turning your hips with it. Great shoulder mobility."],["Block","Hold the pipe horizontally and push it up, down, or out to the side as if stopping an imaginary strike. Go slowly, 8 each direction."],["Thrust","Slide your front hand forward as your back hand pushes the pipe straight ahead at chest height, with a small lunge step. Return to home position."],["Flow","Link 3 moves into one smooth pattern for 1–2 minutes, breathing steadily. Slower is better than fast."]];
const staffCard=()=>`<div class="card"><h3>Staff school</h3><p class="sub">The PVC pipe stands in for a bo staff. Clear about 2 m of space away from walls, lights, and the kitties. Move slowly enough that you could stop mid-move. A 15-minute session: 3 min warm-up, 3 min figure-eights, 3 min sweeps, 3 min blocks and thrusts, 3 min one linked flow.</p>${STF.map(([n,d])=>`<details><summary><b>${n}</b></summary><p class="sub">${d}</p></details>`).join("")}</div>`;
const PLAN=[[1,1,"Baseline","Effort 6 out of 10. Wind: shadow rope 6×30s on/60s off, squats 2×8, step-ups 2×6. Fist: push-ups at your rung 2×5, rows 2×10, plank 2×15s. Staff: grip, stance, figure-eights 3 min."],[2,2,"Smooth it out","Repeat week 1 and focus on clean form. Add 1 minute of staff work."],[3,3,"One more set","Add a third set to each strength move. Rope 8 rounds."],[4,4,"Light week","Back to 2 sets. Check whether you are ready to climb a rung."],[5,5,"Build","Wind: tempo squats 3×8, rope 8 rounds. Fist: push-ups 3×6, rows 3×12. Staff: add overhead sweeps."],[6,6,"Add reps","Add 2 reps to push-ups and squats. Staff: slow blocks."],[7,7,"Push week","Rope 10 rounds, reverse lunges 3×8, push-ups at rung target 3×8. Staff: thrusts."],[8,8,"Light week and rank trial","Retest push-ups and celebrate reaching Acolyte."],[9,10,"Acolyte begins","Rope 30s/30s ×6. Split squats 3×8. 8 lb presses 3×12. Hollow hold progress."],[11,12,"Volume","One lift per day gets a 4th set. Staff: slow strike combos."],[13,14,"Control","Lower everything for 3 seconds. Rope 30/30 ×8."],[15,16,"Light week and retest","Retest push-ups and squats. Pick your Adept variations."],[17,18,"Adept begins","Full or tempo push-ups 3×8. Bulgarian split squats 3×6."],[19,20,"Flow","Staff flows of 10 minutes. Rope 40s/20s ×6."],[21,22,"Peak","Hardest variations for 3 sets near your limit, then a light week."],[23,24,"Final trial","Retest everything, then choose your path for the next cycle."]];
let S={xp:0,log:[],rung:{},cl:{t:0,e:0,r:0},rl:[],notes:[]},tab="today",th="wind",md="home",bonus={pb:0,st:0},draft="",ns="new",ed=0,dl=0;
try{const x=localStorage.getItem(K);if(x)S=Object.assign(S,JSON.parse(x))}catch(e){}
const save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};
const $=id=>document.getElementById(id);
const lvl=()=>Math.floor(S.xp/XPL)+1;
const rank=()=>Math.min(2,Math.floor((lvl()-1)/8));
const wk=d=>{const x=new Date(d);x.setDate(x.getDate()-(x.getDay()+6)%7);x.setHours(0,0,0,0);return +x};
const WEEK=6048e5;
function wcount(){const c={};S.log.filter(l=>l.k==="s").forEach(l=>{const w=wk(l.d);c[w]=(c[w]||0)+1});return c}
function toast(m){const t=$("toast");t.textContent=m;t.style.display="block";clearTimeout(toast.h);toast.h=setTimeout(()=>t.style.display="none",4000)}
function add(xp,entry){const b=lvl();S.xp+=xp;S.log.unshift(Object.assign({d:Date.now(),xp},entry));save();const a=lvl();
 toast(a>b?`Level ${a} reached! A reward is waiting in Rewards.`:`+${xp} XP. Well done.`);render()}
function done(){const gap=S.log.find(l=>l.k==="s");let xp=md==="floor"?60:100,note=[];
 if(gap&&Date.now()-gap.d>5*864e5){xp+=50;note.push("comeback")}
 if(bonus.pb){xp+=25;note.push("personal best")}if(bonus.st){xp+=25;note.push("steps")}
 const name=md==="floor"?"Meditation Floor":T[th].n;add(xp,{k:"s",t:name+(md==="floor"?"":md==="gym"?" (gym)":" (home)"),n:note.join(", ")});bonus={pb:0,st:0}}
function adv(k){const L=LAD[k][1],r=S.rung[k]||0;if(r>=L.length-1)return;S.rung[k]=r+1;add(40,{k:"r",t:"Skill: "+L[r+1]})}
function claim(t,i){const n=lvl()-1,own={t:n,e:Math.floor(n/3),r:Math.min(2,Math.floor(n/8))};if(S.cl[t]>=own[t])return;
 S.cl[t]++;S.rl.unshift({d:Date.now(),t:RW[t][i]});save();toast("Enjoy: "+RW[t][i]);render()}
function render(){const l=lvl(),p=(S.xp%XPL)/XPL;$("lv").textContent=l;$("rp").style.strokeDashoffset=326.7*(1-p);
 $("rk").textContent=l>24?"Adept, path chosen":RN[rank()];$("xp").textContent=`${S.xp%XPL} / ${XPL} XP to level ${l+1}`;
 const c=wcount()[wk(Date.now())]||0;$("fl").textContent="🔥".repeat(Math.min(c,3))+"▫️".repeat(Math.max(0,3-c));
 $("nav").innerHTML=[["today","Train"],["plan","Plan"],["skills","Skills"],["rewards","Rewards"],["path","Journey"]].map(([k,n])=>`<button class="${tab===k?"on":""}" onclick="tab='${k}';render()">${n}</button>`).join("");
 $("main").innerHTML=V[tab]()}
const chips=(arr,cur,fn)=>`<div class="row">${arr.map(([k,n])=>`<button class="chip ${cur===k?"on":""}" onclick="${fn}('${k}')">${n}</button>`).join("")}</div>`;
const V={
today(){const list=md==="floor"?FL:T[th][md==="gym"?"g":"h"];const early=S.log.filter(x=>x.k==="s").length<6;
 return `<p class="sub">Any 3 days work. Rest days are part of the path.${early?" Early sessions: aim for effort 6 out of 10, even if you feel great.":""}</p>
 <h2>Choose your training</h2>${chips(Object.entries(T).map(([k,v])=>[k,v.n]),th,"setT")}
 <p class="sub">${T[th].s}</p>${chips([["gym","At the gym"],["home","At home"],["floor","10-min floor"]],md,"setM")}
 <div class="card">${list.map(x=>`<div style="border-bottom:1px solid var(--line);padding:4px 0"><label class="ck" style="border:0;padding:4px 0"><input type="checkbox"><span>${x}</span></label>${gl(x)}</div>`).join("")}</div>${th==="staff"&&md!=="floor"?staffCard():""}
 <div class="card"><label class="ck"><input type="checkbox" ${bonus.pb?"checked":""} onchange="bonus.pb=this.checked?1:0"><span>Personal best on something (+25 XP)</span></label>
 <label class="ck"><input type="checkbox" ${bonus.st?"checked":""} onchange="bonus.st=this.checked?1:0"><span>Hit about 6,500 steps today (+25 XP, optional)</span></label></div>
 <button class="pri" onclick="done()">Complete session (+${md==="floor"?60:100} XP)</button>
 <p class="sub">The 10-minute floor still counts. Showing up small beats skipping.</p>`},
plan(){const f=S.log.filter(l=>l.k==="s").pop(),n=f?Math.min(24,Math.floor((wk(Date.now())-wk(f.d))/WEEK)+1):1;
 return `<p class="sub">${f?`You’re in week ${n}.`:"Week 1 starts with your first session."} Each rank lasts 8 weeks. Every 4th week is lighter on purpose.</p>`+PLAN.map(([a,b,t,d])=>`<details class="card" ${n>=a&&n<=b?"open":""}><summary><b>${a===b?"Week "+a:"Weeks "+a+"–"+b}: ${t}</b></summary><p class="sub">${d}</p></details>`).join("")},
skills(){return `<p class="sub">Move up a rung after hitting the target in 2 sessions in a row, and change only one thing at a time. Push-up start: test each rung from the wall upward and begin at the first one where 10 clean reps is hard.</p>`+Object.entries(LAD).map(([k,[n,L]])=>{const r=S.rung[k]||0;
 return `<div class="card"><h3>${n}</h3><p class="sub">Now: <b>${L[r]}</b><br>${RD[L[r]]||""}${r<L.length-1?`<br><i>Next:</i> ${L[r+1]}`:"<br>Ladder complete!"}</p><div class="bar"><i style="width:${(r+1)/L.length*100}%"></i></div>
 ${r<L.length-1?`<button style="margin-top:10px" onclick="adv('${k}')">Climb a rung (+40 XP)</button>`:""}</div>`}).join("")},
rewards(){const n=lvl()-1,own={t:n,e:Math.floor(n/3),r:Math.min(2,Math.floor(n/8))};
 const g=[["t","Level-up rewards","Every level earns one. Free time, guilt-free."],["e","Adventure rewards","One every 3rd level. Nature or culture."],["r","Rank-up rewards","One per rank you complete."]];
 return g.map(([t,h,d])=>{const a=own[t]-S.cl[t];return `<div class="card"><h3>${h}</h3><p class="sub">${d} <span class="tok">${a} available</span></p>
 ${RW[t].map((x,i)=>`<button style="width:100%;text-align:left;margin-top:6px" ${a>0?"":"disabled"} onclick="claim('${t}',${i})">${x}</button>`).join("")}</div>`}).join("")},
path(){const c=wcount(),w=Object.values(c).filter(x=>x>=2).length;let run=0,w0=wk(Date.now());if((c[w0]||0)<2)w0-=WEEK;while((c[w0]||0)>=2){run++;w0-=WEEK}
 const rows=S.log.slice(0,12).map(l=>`<div class="log"><span>${new Date(l.d).toLocaleDateString(undefined,{month:"short",day:"numeric"})} · ${l.t}${l.n?" ("+l.n+")":""}</span><b>+${l.xp}</b></div>`).join("")||`<p class="sub">Your first session starts the story.</p>`;
 const rl=S.rl.slice(0,5).map(l=>`<div class="log"><span>${l.t}</span></div>`).join("");
 return `<div class="card"><h3>The story so far</h3><p class="sub">You arrived at the mountain monastery as an Initiate. Train 8 levels each to become Acolyte, then Adept. Then you choose your path and begin a new cycle.</p>
 <div class="bar"><i style="width:${Math.min(100,(lvl()-1)/24*100)}%"></i></div><p class="sub">Level ${Math.min(lvl(),24)} of 24 in this cycle</p></div>
 <div class="card"><h3>Weeks tended: ${w}</h3><p class="sub">${run?`Current run: ${run} week${run>1?"s":""}.`:"Your run is resting. Nothing is lost. Two sessions in a week tends the flame again."} Weeks tended never go down.</p></div>
 ${journal()}<h2>Recent training</h2><div class="card">${rows}</div>${rl?`<h2>Rewards enjoyed</h2><div class="card">${rl}</div>`:""}
 ${backup()}<p class="sub">Progress saves in this browser on this device. Export a backup every week or two.</p>`}};
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function addN(){const t=draft.trim();if(!t)return;S.notes.push({id:Date.now(),d:Date.now(),t});draft="";save();toast("Entry added to your story.");render()}
function delN(id){if(dl!==id){dl=id;render();return}S.notes=S.notes.filter(n=>n.id!==id);dl=0;save();render()}
function saveN(id){const t=$("ed").value.trim(),n=S.notes.find(n=>n.id===id);if(t&&n){n.t=t;save()}ed=0;render()}
function exp(){const j=JSON.stringify({app:"monkspath",v:1,saved:new Date().toISOString(),data:S},null,1);$("bk").value=j;try{const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([j],{type:"application/json"}));a.download="monks-path-backup-"+new Date().toISOString().slice(0,10)+".json";document.body.appendChild(a);a.click();a.remove()}catch(e){}toast("Backup ready. If no file downloaded, copy the text from the box.")}
function imp(){try{const o=JSON.parse($("bk").value);if(o.app!=="monkspath"||!o.data)throw 0;S=Object.assign({xp:0,log:[],rung:{},cl:{t:0,e:0,r:0},rl:[],notes:[]},o.data);save();toast("Backup restored.");render()}catch(e){toast("That doesn’t look like a Monk’s Path backup.")}}
function impF(i){const f=i.files[0];if(f)f.text().then(t=>{$("bk").value=t;imp()})}
function journal(){const L=[...S.notes].sort((a,b)=>ns==="new"?b.d-a.d:a.d-b.d),fd=d=>new Date(d).toLocaleDateString(undefined,{weekday:"short",month:"short",day:"numeric",year:"numeric"});
 return `<h2>Story journal</h2><div class="card"><textarea id="nt" placeholder="How did today’s training go? What happens to your character next?" oninput="draft=this.value">${esc(draft)}</textarea><button class="pri" onclick="addN()">Add entry</button></div>
 <div class="row" style="align-items:center"><span class="sub" style="flex:1">${L.length} entr${L.length===1?"y":"ies"}</span><button onclick="ns=ns==='new'?'old':'new';render()">${ns==="new"?"Newest first":"Oldest first"}</button></div>`+
 L.map(n=>`<div class="card"><p class="sub"><b>${fd(n.d)}</b></p>${ed===n.id?`<textarea id="ed">${esc(n.t)}</textarea><div class="row"><button class="chip" onclick="saveN(${n.id})">Save</button><button class="chip" onclick="ed=0;render()">Cancel</button></div>`:`<p style="white-space:pre-wrap;margin:4px 0">${esc(n.t)}</p><div class="row"><button class="chip" onclick="ed=${n.id};render()">Edit</button><button class="chip" onclick="delN(${n.id})">${dl===n.id?"Tap again to delete":"Delete"}</button></div>`}</div>`).join("")}
function backup(){return `<h2>Backup</h2><div class="card"><p class="sub">Export saves your journal, XP, skills and rewards to a file. Importing replaces what is on this device. Keep backups somewhere private.</p><div class="row"><button class="chip" onclick="exp()">Export backup</button><button class="chip" onclick="$('fi').click()">Import file</button><input id="fi" type="file" accept=".json,application/json" hidden onchange="impF(this)"></div><textarea id="bk" placeholder="Backup text appears here. Paste a backup here and tap the button to import."></textarea><button style="margin-top:8px" onclick="imp()">Import from text</button></div>`}
function setT(k){th=k;render()}function setM(k){md=k;render()}
render();
</script></body></html>
